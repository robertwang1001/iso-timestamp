{
  "name": "iso-timestamp",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "description": "Generate ISO 8601 timestamp: YYYYMMDDhhmmssSSS",
  "author": {
    "name": "Robert Wang",
    "email": "glorywong1001@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/robertwang1001/iso-timestamp#readme",
  "repository": "github:robertwang1001/iso-timestamp",
  "bugs": "https://github.com/robertwang1001/iso-timestamp/issues",
  "keywords": [
    "timestamp",
    "datetime",
    "date",
    "time",
    "format",
    "generator",
    "utility",
    "typescript",
    "javascript",
    "iso8601",
    "chrono",
    "time-stamp"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm test && pnpm build",
    "prepare": "pnpm simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^10.14.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit ${1}",
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
